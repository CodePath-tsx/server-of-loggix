# Serveur
PORT=3000
SERVER_LAN_IP=192.168.1.10
NODE_ENV=production

# Base de données PostgreSQL
DATABASE_URL=postgres://logixstore:motdepasse@localhost:5432/logixstore

# Sécurité (générez des secrets aléatoires longs)
JWT_SECRET=changez-moi-secret-acces-32-caracteres
JWT_REFRESH_SECRET=changez-moi-secret-refresh-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Réseau local autorisé (séparé par des virgules)
CORS_ORIGINS=http://localhost:5173,http://192.168.1.10:5173

# Limitation de débit
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Compte propriétaire créé à l'initialisation
OWNER_DEFAULT_PASSWORD=ChangeMoi123!

# Sauvegardes
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
