PORT=3000
SERVER_LAN_IP=192.168.1.36

# Database: postgres://username:password@host:port/database
# WARNING: Password must contain ONLY alphanumeric characters and basic symbols (no spaces, no colons)
# Example safe passwords: Logix2024, LogixPass123, POS123!
DATABASE_URL=postgres://postgres:Logix2024@localhost:5432/logixstore

# JWT Secrets - Change to your own 32+ character random strings in production
JWT_SECRET=your-super-secret-access-key-minimum-32-characters-required
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-required
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS: Allow all origins within local network (safe inside private network)
# For production on internet, restrict to specific domains
# Examples: 
#   - CORS_ORIGINS=* (allow all - use only on private LAN)
#   - CORS_ORIGINS=http://localhost:3000,http://192.168.1.*:* (pattern-based)
#   - CORS_ORIGINS=http://192.168.1.36:5173,http://192.168.1.36:8080 (specific ports)
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Default Owner Account
OWNER_DEFAULT_PASSWORD=ChangeMoi123!

# Backup Configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Environment
NODE_ENV=production
